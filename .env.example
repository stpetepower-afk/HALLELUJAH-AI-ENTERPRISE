# .env.example

# Example environment variables (DO NOT commit real secrets)
NVIDIA_API_KEY=nvapi-REPLACE_ME
OPENAI_API_KEY=sk-REPLACE_ME
NODE_ENV=development
PORT=3000

# Required once a real Postgres database exists (see src/db/schema)
